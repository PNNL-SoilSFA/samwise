/*
 * SLURM execution profile for SAMWISE Module 0.
 *
 * This profile is intended to parallelize ONLY the RUN_FASTQC process.
 *
 * Usage:
 *
 *   nextflow run module_0_readprocess.nf \
 *       -c ./bin/module_0_slurm.config \
 *       --input_dir /path/to/test_reads \
 *       --working_dir /path/to/samwise \
 *       --slurm_account ChargeAccountID \
 *       --max_parallel_fastqc 8
 *
 * IMPORTANT:
 *   module_0_readprocess.nf does NOT need to be modified to use this config.
 *
 *   CHECK_READ_NAMING, SETUP_MODULE0_TOOLS, VALIDATE_READS, and
 *   SKIP_VALIDATE_READS remain on the local executor.
 *
 *   Each RUN_FASTQC task is submitted as an independent SLURM job.
 *
 *   Unlike Module 2, FastQC does NOT request an entire node. Each FastQC
 *   task requests only the CPUs and memory it needs.
 */

params {

    // ---- Site-specific SLURM settings -------------------------------------

    // SLURM account, i.e. sbatch --account.
    slurm_account = null

    // SLURM partition, i.e. sbatch --partition.
    // Null uses the cluster default.
    slurm_partition = null

    // SLURM quality of service, i.e. sbatch --qos.
    slurm_qos = null

    // Additional raw sbatch options, appended verbatim.
    slurm_extra_options = ''

    // ---- FastQC resources --------------------------------------------------

    // Maximum number of FastQC jobs allowed to run/queue through Nextflow.
    //
    // Start conservatively for the test run. For example:
    //
    //   --max_parallel_fastqc 4
    //
    // Once the test works, increase this as appropriate for the cluster.
    max_parallel_fastqc = 8

    // FastQC normally uses 2 CPUs in module_0_readprocess.nf.
    //
    // This should normally match --fastqc_threads or --threads supplied to
    // the workflow.
    fastqc_memory = '4 GB'

    // Maximum wall time for one FastQC task.
    //
    // FastQC is much shorter than the Module 2 assembly jobs, so 4 hours
    // provides a conservative initial limit for testing.
    fastqc_time = '4h'

    // Number of times a FastQC SLURM task may be retried after a scheduler/
    // node-related failure.
    fastqc_max_retries = 2

    // Optional commands to run before each SLURM task.
    //
    // Leave empty unless your cluster requires something such as:
    //
    //   source ~/.bashrc
    //
    // FastQC itself is supplied by the module-local environment created by
    // SETUP_MODULE0_TOOLS, so this should normally remain empty.
    slurm_before_script = ''
}

/*
 * RUN_FASTQC is the only process intentionally moved to SLURM.
 *
 * Because RUN_FASTQC receives one read file per task, Nextflow can submit
 * independent FastQC jobs for each read file.
 */

process {

    withName: 'RUN_FASTQC' {

        executor = 'slurm'

        /*
         * FastQC gets its CPU count from module_0_readprocess.nf:
         *
         *   params.threads != null
         *       ? params.threads as int
         *       : params.fastqc_threads as int
         *
         * Therefore this config does not override cpus. The workflow remains
         * the source of truth for the number of FastQC threads.
         */

        memory = params.fastqc_memory
        time = params.fastqc_time

        clusterOptions = {
            def opts = []

            if (params.slurm_account) {
                opts << "--account=${params.slurm_account}"
            }

            if (params.slurm_partition) {
                opts << "--partition=${params.slurm_partition}"
            }

            if (params.slurm_qos) {
                opts << "--qos=${params.slurm_qos}"
            }

            if (params.slurm_extra_options) {
                opts << "${params.slurm_extra_options}"
            }

            return opts.join(' ')
        }

        beforeScript = { params.slurm_before_script ?: null }

        /*
         * Limit the number of RUN_FASTQC tasks that Nextflow schedules at once.
         */
        maxForks = params.max_parallel_fastqc

        /*
         * Retry jobs that appear to have been killed by the scheduler or
         * underlying node rather than retrying ordinary FastQC failures.
         */
        errorStrategy = {
            task.exitStatus in [104, 134, 137, 139, 140, 143, 247, 250, 251]
                ? 'retry'
                : 'terminate'
        }

        maxRetries = params.fastqc_max_retries
    }

    /*
     * Everything except RUN_FASTQC remains local.
     *
     * These are lightweight orchestration/setup tasks and should not consume
     * separate SLURM jobs.
     */
    withName: 'SETUP_MODULE0_TOOLS|CHECK_READ_NAMING|VALIDATE_READS|SKIP_VALIDATE_READS' {
        executor = 'local'
    }

    /*
     * Do not use node-local scratch by default. Module 0 stages FASTQ files
     * using symlinks, which is appropriate when the input files are on a
     * shared filesystem accessible to the compute nodes.
     */
    scratch = false
}

/*
 * Global executor settings.
 *
 * queueSize provides the global backstop for the number of outstanding
 * tasks. maxForks above specifically limits RUN_FASTQC.
 */

executor {

    queueSize = params.max_parallel_fastqc

    /*
     * Avoid submitting a large number of jobs to SLURM simultaneously.
     * This is particularly useful when testing against a directory containing
     * many read files.
     */
    submitRateLimit = '20/1min'

    /*
     * How frequently Nextflow checks SLURM job status.
     */
    pollInterval = '30 sec'

    queueStatInterval = '2 min'
}

/*
 * Nextflow execution reports.
 *
 * These are useful for verifying that RUN_FASTQC was actually executed by
 * SLURM and for inspecting resource usage after the test.
 */

timeline {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_0_readprocess/pipeline_info/module0_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_0_readprocess/pipeline_info/module0_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_0_readprocess/pipeline_info/module0_trace.txt"
    fields = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem'
}
