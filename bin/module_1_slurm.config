/*
 * SLURM execution profile for SAMWISE Module 1 read trimming.
 *
 * This opt-in profile parallelizes the per-sample fastp tasks and the FastQC
 * tasks that consume their trimmed reads. FastQC begins automatically for each
 * read file only after its upstream fastp task has completed successfully.
 *
 * Usage:
 *
 *   nextflow run module_1_readtrimming.nf \
 *       -c bin/module_1_slurm.config \
 *       --working_dir /path/to/results \
 *       --slurm_account ChargeAccountID \
 *       --max_parallel_trimming 8 \
 *       --fastp_threads 4 \
 *       --fastqc_threads 2
 *
 * The workflow remains responsible for CPU allocation: --threads overrides
 * both process-specific thread parameters; otherwise fastp uses
 * --fastp_threads and FastQC uses --fastqc_threads. This config does not
 * override `cpus`, so SLURM requests exactly the CPUs selected by the module.
 *
 * SETUP_MODULE1_TOOLS and the TSV summary/manifest processes remain local.
 * This profile is deliberately not named nextflow.config so it is not applied
 * automatically to unrelated SAMWISE modules.
 */

params {

    // Workflow root parameters are declared here because Nextflow evaluates
    // report paths while reading this config, before module_1_readtrimming.nf
    // supplies its compatibility defaults. Command-line values override these
    // null defaults; if neither root is provided, reports use the launch path.
    working_dir = null
    samwise_dir = null

    // ---- Site-specific SLURM settings -------------------------------------
    // Leave a value empty/null to omit that sbatch flag entirely.
    slurm_account = null
    slurm_partition = null
    slurm_qos = null
    slurm_extra_options = ''

    // Commands to run in each SLURM task before the process script, if needed
    // at a specific site, e.g. 'source /etc/profile; module load apptainer'.
    // The Module 1 managed environment supplies fastp and FastQC by default.
    slurm_before_script = ''

    // ---- Parallelism -------------------------------------------------------
    // Maximum combined number of per-sample fastp and post-trimming FastQC
    // tasks that Nextflow may submit/run at once. FastQC tasks only become
    // runnable after their associated fastp task finishes.
    max_parallel_trimming = 8

    // ---- Per-task resources ------------------------------------------------
    // CPU requests are inherited from the workflow, as documented above.
    fastp_memory = '8 GB'
    fastp_time = '12h'
    fastqc_memory = '4 GB'
    fastqc_time = '4h'

    // Retries cover scheduler/node failures, not ordinary fastp/FastQC errors.
    trimming_max_retries = 2
}

process {

    // Per-sample trimming fan-out. Paired and interleaved inputs use separate
    // processes, but share the same SLURM policy and global concurrency cap.
    withName: 'FASTP_PAIRED|FASTP_INTERLEAVED' {
        executor = 'slurm'
        memory = params.fastp_memory
        time = params.fastp_time

        clusterOptions = {
            def opts = []

            if (params.slurm_account) {
                opts << "--account=${params.slurm_account}"
            }
            if (params.slurm_partition) {
                opts << "--partition=${params.slurm_partition}"
            }
            if (params.slurm_qos) {
                opts << "--qos=${params.slurm_qos}"
            }
            if (params.slurm_extra_options) {
                opts << "${params.slurm_extra_options}"
            }

            return opts.join(' ')
        }

        beforeScript = { params.slurm_before_script ?: null }
        maxForks = params.max_parallel_trimming
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247, 250, 251] ? 'retry' : 'terminate' }
        maxRetries = params.trimming_max_retries
        scratch = false
    }

    // One FastQC job per trimmed read file. These tasks wait on fastp through
    // the workflow channel dependencies; no manual sequencing is required.
    withName: 'RUN_FASTQC_TRIMMED' {
        executor = 'slurm'
        memory = params.fastqc_memory
        time = params.fastqc_time

        clusterOptions = {
            def opts = []

            if (params.slurm_account) {
                opts << "--account=${params.slurm_account}"
            }
            if (params.slurm_partition) {
                opts << "--partition=${params.slurm_partition}"
            }
            if (params.slurm_qos) {
                opts << "--qos=${params.slurm_qos}"
            }
            if (params.slurm_extra_options) {
                opts << "${params.slurm_extra_options}"
            }

            return opts.join(' ')
        }

        beforeScript = { params.slurm_before_script ?: null }
        maxForks = params.max_parallel_trimming
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247, 250, 251] ? 'retry' : 'terminate' }
        maxRetries = params.trimming_max_retries
        scratch = false
    }

    // Setup and summary tasks are lightweight and remain on the launch host.
    withName: 'SETUP_MODULE1_TOOLS|TRIMMING_STATS_PAIRED|TRIMMING_STATS_INTERLEAVED|WRITE_TRIMMING_STATS_SUMMARY|WRITE_TRIMMED_MANIFEST' {
        executor = 'local'
        cpus = 1
    }
}

executor {
    // Global queue cap backs up the per-process maxForks settings and prevents
    // a large input manifest from submitting every task to SLURM at once.
    queueSize = params.max_parallel_trimming
    submitRateLimit = '20/1min'
    pollInterval = '30 sec'
    queueStatInterval = '2 min'
}

// params.outdir is assigned by the workflow after config evaluation. Derive
// report locations directly from the two compatible root parameters instead.
timeline {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_1_readtrimming/pipeline_info/module1_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_1_readtrimming/pipeline_info/module1_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_1_readtrimming/pipeline_info/module1_trace.txt"
    fields = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem'
}
