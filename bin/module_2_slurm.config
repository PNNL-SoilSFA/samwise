/*
 * SLURM execution profile for SAMWISE Module 2 (parallel variant).
 *
 * Usage:
 *
 *   nextflow run module_2_readassembly_parallel.nf \
 *       -c conf/module_2_slurm.config \
 *       --working_dir /path/to/samwise-main \
 *       --slurm_account samwise \
 *       --threads 36 \
 *       --memory_gb 0 \
 *       --megahit --metaspades \
 *       --rarefied_assembly TRUE --rarefaction_splits 2
 *
 * What this changes versus running without it:
 *
 *   Before: Nextflow runs on one node with the local executor. Every assembly
 *           asks for --threads cores, so on a 36-core node exactly one
 *           assembly runs at a time and the rest queue behind it.
 *
 *   After:  Nextflow only orchestrates. Each ASSEMBLE_SINGLE / ASSEMBLE_RAREFIED
 *           task is submitted as its own sbatch job on its own node, up to
 *           --max_parallel_assemblies at once.
 *
 * This file is opt-in. It is deliberately NOT named nextflow.config: a file
 * with that name in the repo root is auto-loaded by every module, and the
 * current scope is Module 2 only.
 *
 * IMPORTANT: keep --memory_gb 0 when using this config. Assembly jobs request
 * whole nodes (--exclusive --mem=0), and a non-zero --memory_gb would make
 * Nextflow emit a second, conflicting --mem to sbatch. With --memory_gb 0 the
 * assembler auto-detects the node's memory instead; see the memory handling in
 * bin/samwise_run_assembler.py.
 */

params {

    // ---- Site-specific SLURM settings -------------------------------------
    // Leave a value empty/null to omit that sbatch flag entirely.

    // SLURM account, i.e. sbatch -A. run_SAMWISE.sh currently uses "samwise".
    slurm_account = null

    // Partition/queue, i.e. sbatch -p. Null uses the cluster default, which is
    // what run_SAMWISE.sh relies on today.
    slurm_partition = null

    // Quality of service, i.e. sbatch --qos.
    slurm_qos = null

    // Extra raw sbatch flags, appended verbatim.
    slurm_extra_options = ''

    // ---- Parallelism -------------------------------------------------------

    // How many assembly jobs may be in the SLURM queue at once. This is the
    // "X" in "run X assemblies in parallel on X nodes". Raise it to use more
    // of the cluster; lower it to be a better neighbour on a shared system.
    max_parallel_assemblies = 8

    // Wall time requested per assembly job. metaSPAdes on deep metagenomes is
    // the long pole here.
    assembly_time = '48h'

    // Retries per assembly job. Covers node failure and preemption, not
    // genuine assembly errors.
    assembly_max_retries = 2

    // Whether each assembly job takes a whole node. Chosen to match the
    // current --threads 36 behaviour exactly: same per-assembly speed, with
    // parallelism coming from using several nodes at once.
    slurm_exclusive = true

    // Some sites reject --mem=0. Set false if sbatch complains, and the job
    // falls back to the cluster's default memory allocation.
    slurm_request_all_memory = true

    // Commands to run inside each job before the task starts, e.g. sourcing a
    // profile or activating a conda environment. Needed when the assemblers
    // come from your interactive environment rather than from the environment
    // SETUP_MODULE2_TOOLS builds. Example:
    //   --slurm_before_script 'source ~/.bashrc; mamba activate nextflow'
    slurm_before_script = ''
}

process {

    // The heavy, fan-out work: one sbatch job per assembly.
    withName: 'ASSEMBLE_SINGLE|ASSEMBLE_RAREFIED' {

        executor = 'slurm'

        // The sbatch option string is built in a closure, not precomputed, so
        // it is evaluated when a task is actually submitted. That guarantees
        // any --slurm_* value given on the command line is already in effect,
        // with no dependency on whether config is parsed before or after
        // command-line params are bound. (Inlined here rather than shared via
        // a top-level variable because the strict config syntax used by
        // current Nextflow releases forbids variables in config files.)
        clusterOptions = {
            def opts = []

            if (params.slurm_exclusive) {
                opts << '--exclusive'
                opts << '--nodes=1'

                if (params.slurm_request_all_memory) {
                    // In SLURM, --mem=0 means "all memory on the allocated node".
                    opts << '--mem=0'
                }
            }

            if (params.slurm_account) {
                opts << "--account=${params.slurm_account}"
            }

            if (params.slurm_partition) {
                opts << "--partition=${params.slurm_partition}"
            }

            if (params.slurm_qos) {
                opts << "--qos=${params.slurm_qos}"
            }

            if (params.slurm_extra_options) {
                opts << params.slurm_extra_options.toString()
            }

            return opts.join(' ')
        }
        time = { params.assembly_time }
        beforeScript = { params.slurm_before_script ?: null }

        // Retry only on exit codes that mean the scheduler killed the job or
        // the node died -- not on assembler errors. metaSPAdes exit 12 (out of
        // memory) is deliberately absent: the pipeline already records it as a
        // non-fatal result so the summary steps can still run.
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247, 250, 251] ? 'retry' : 'terminate' }
        maxRetries = params.assembly_max_retries
    }

    // Cheap bookkeeping steps stay on the driver host. Submitting a whole node
    // to concatenate a few TSV files would be wasteful and slow.
    withName: 'SETUP_MODULE2_TOOLS|WRITE_ASSEMBLY_SUMMARIES' {
        executor = 'local'
        cpus = 1
    }

    // Assemblies read and write on the shared filesystem directly. Point this
    // at node-local storage (e.g. '/scratch') only if your site has fast local
    // disk with room for a full assembly.
    scratch = false
}

executor {

    $slurm {
        // Cap on simultaneously queued/running assembly jobs.
        queueSize = params.max_parallel_assemblies

        // Avoid hammering the scheduler when many samples start at once.
        submitRateLimit = '20/1min'

        // How often Nextflow polls SLURM for job state.
        pollInterval = '30 sec'
        queueStatInterval = '2 min'
    }

    $local {
        queueSize = 2
    }
}

/*
 * Execution reports, written next to the Module 2 outputs.
 *
 * params.outdir cannot be used here: Module 2 defines it inside the .nf, which
 * is evaluated after this config, so it is still null at this point. The same
 * derivation the module uses is repeated instead, from params that arrive on
 * the command line -- spelled out in each path below because the strict
 * config syntax forbids top-level variables in config files.
 */

timeline {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: (params.output_dir ?: '.')}/module_2_readassembly/pipeline_info/module2_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: (params.output_dir ?: '.')}/module_2_readassembly/pipeline_info/module2_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: (params.output_dir ?: '.')}/module_2_readassembly/pipeline_info/module2_trace.txt"
    fields = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem'
}
