/*
 * SLURM execution profile for SAMWISE Module 2b co-assembly.
 *
 * Combined from two earlier drafts kept alongside it as reference:
 *
 *   module_2b_slurm.josue.config  strict config syntax (no top-level variables
 *                                 or statements), which the parser in current
 *                                 Nextflow releases requires. Its structure and
 *                                 parameter names are used here unchanged.
 *   module_2b_slurm.jesun.config  written for module_2b_coassembly_parallel.nf;
 *                                 its notes on the co-assembly speed-up ceiling,
 *                                 walltime, and queueSize scoping are folded in.
 *
 * Usage -- works with module_2b_coassembly.nf and the parallel variant alike,
 * since both define the same process names:
 *
 *   nextflow run module_2b_coassembly_parallel.nf \
 *       -c bin/module_2b_slurm.config \
 *       --working_dir /path/to/results \
 *       --coassembly_groups coassembly_groups.tsv \
 *       --slurm_account samwise \
 *       --max_parallel_coassemblies 4 \
 *       --threads 36 \
 *       --memory_gb 0
 *
 * What this changes versus running without it:
 *
 *   Before: Nextflow runs on one node with the local executor. Every co-assembly
 *           asks for --threads cores, so exactly one runs at a time and the
 *           rest queue behind it.
 *
 *   After:  Nextflow only orchestrates. Each ASSEMBLE_COASSEMBLY task is
 *           submitted as its own sbatch job on its own node, up to
 *           --max_parallel_coassemblies at once. Setup, group preparation and
 *           summary steps stay local on the Nextflow launch host.
 *
 * Note the ceiling: there is one job per co-assembly GROUP, so with N groups
 * the speed-up is at most N-fold, the largest group sets a hard floor on wall
 * time, and with a single group there is no speed-up at all.
 *
 * This file is opt-in. It is deliberately NOT named nextflow.config: a file
 * with that name in the repo root is auto-loaded by every module.
 *
 * IMPORTANT: retain --memory_gb 0 when using the default exclusive whole-node
 * settings below. The profile adds SLURM --mem=0, while MEGAHIT auto-detects
 * memory from the allocated node. A nonzero --memory_gb would cause Nextflow
 * to add a second, conflicting SLURM memory request.
 */

params {

    // ---- Site-specific SLURM settings -------------------------------------
    // Leave a value empty/null to omit that sbatch flag entirely.
    slurm_account = null
    slurm_partition = null
    slurm_qos = null
    slurm_extra_options = ''

    // ---- Parallelism -------------------------------------------------------
    // Maximum distinct coassembly groups submitted/running at once. This only
    // bites when there are more groups than this number.
    max_parallel_coassemblies = 4

    // Wall time for each group-level MEGAHIT co-assembly job. Co-assemblies
    // concatenate every sample in a group, so they run considerably longer
    // than Module 2's single-sample assemblies; raise this for large groups
    // (e.g. --coassembly_time 96h). Whatever the value, the job that launches
    // Nextflow must be allowed to outlive it: if the launcher hits its own
    // walltime first, running co-assemblies are orphaned and their results
    // are never collected.
    coassembly_time = '48h'

    // Retries per co-assembly job. Covers node failure and preemption, not
    // genuine assembly errors.
    coassembly_max_retries = 2

    // One coassembly per exclusive node by default. This matters more here
    // than in Module 2: a co-assembly holds every read in the group in memory,
    // so it is the most memory-hungry step in the pipeline.
    slurm_exclusive = true

    // Set false if the local SLURM installation rejects --mem=0.
    slurm_request_all_memory = true

    // Optional commands run in each SLURM job before the process script.
    // Example: --slurm_before_script 'source /etc/profile; module load python'
    slurm_before_script = ''
}

process {

    // Heavy fan-out work: one SLURM job for each coassembly group.
    withName: 'ASSEMBLE_COASSEMBLY' {
        executor = 'slurm'

        // Built in a closure, not precomputed, so it is evaluated when a task
        // is actually submitted, with any --slurm_* command-line values
        // already in effect.
        clusterOptions = {
            def opts = []

            if (params.slurm_exclusive) {
                opts << '--exclusive'
                opts << '--nodes=1'

                if (params.slurm_request_all_memory) {
                    // SLURM --mem=0 requests all memory on the allocated node.
                    opts << '--mem=0'
                }
            }

            if (params.slurm_account) {
                opts << "--account=${params.slurm_account}"
            }

            if (params.slurm_partition) {
                opts << "--partition=${params.slurm_partition}"
            }

            if (params.slurm_qos) {
                opts << "--qos=${params.slurm_qos}"
            }

            if (params.slurm_extra_options) {
                opts << "${params.slurm_extra_options}"
            }

            return opts.join(' ')
        }

        time = params.coassembly_time

        // `?: null` means "no beforeScript" when none was supplied, without
        // injecting a literal "null" or empty line into the job script.
        beforeScript = { params.slurm_before_script ?: null }

        // Backstop for the global executor.queueSize below.
        maxForks = params.max_parallel_coassemblies

        // Retry scheduler/node failures, but fail immediately on real assembly
        // errors so the group log remains the authoritative diagnostic.
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247, 250, 251] ? 'retry' : 'terminate' }
        maxRetries = params.coassembly_max_retries

        // Coassembly input FASTQs can be large; use shared storage by default.
        scratch = false
    }

    // Keep lightweight orchestration steps off the cluster queue.
    withName: 'SETUP_MODULE2B_TOOLS|PREPARE_COASSEMBLY_GROUPS|WRITE_ASSEMBLY_SUMMARY|WRITE_COASSEMBLY_TRIMMED_MANIFEST' {
        executor = 'local'
        cpus = 1
    }
}

executor {
    // Global cap on how many tasks are submitted/running at once, matching the
    // per-process maxForks cap above. This applies to every executor the run
    // uses (capping the local executor too, which is harmless -- it only runs
    // the setup, group-preparation and summary steps).
    //
    // IMPORTANT: do NOT rewrite this as `executor { $slurm { queueSize = N } }`.
    // That scoped form does not reliably apply on every Nextflow version, and
    // when it silently no-ops Nextflow falls back to its default queueSize of
    // 100 -- which submits every co-assembly at once and looks exactly like
    // the flag being ignored.
    queueSize = params.max_parallel_coassemblies
    submitRateLimit = '20/1min'
    pollInterval = '30 sec'
    queueStatInterval = '2 min'
}

// params.outdir is assigned in the workflow after configuration loads, so use
// the same command-line base-directory derivation for report locations.
timeline {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_2b_coassembly/pipeline_info/module2b_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_2b_coassembly/pipeline_info/module2b_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_2b_coassembly/pipeline_info/module2b_trace.txt"
    fields = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem'
}
