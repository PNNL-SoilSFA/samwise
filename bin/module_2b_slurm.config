/*
 * SLURM execution profile for SAMWISE Module 2B coassemblies.
 *
 * Usage:
 *
 *   nextflow run module_2b_coassembly.nf \
 *       -c bin/module_2b_slurm.config \
 *       --working_dir /path/to/samwise-main \
 *       --coassembly_groups coassembly_groups.tsv \
 *       --slurm_account samwise \
 *       --threads 36 \
 *       --memory_gb 0 \
 *       --max_parallel_coassemblies 4
 *
 * This profile submits one ASSEMBLE_COASSEMBLY task per distinct coassembly
 * group as an sbatch job. The number of simultaneous jobs is limited by
 * --max_parallel_coassemblies. Setup, group preparation, and summary steps
 * remain local on the Nextflow launch host.
 *
 * IMPORTANT: retain --memory_gb 0 when using the default exclusive whole-node
 * settings below. The profile adds SLURM --mem=0, while MEGAHIT auto-detects
 * memory from the allocated node. A nonzero --memory_gb would cause Nextflow
 * to add a second, conflicting SLURM memory request.
 */

params {

    // ---- Site-specific SLURM settings -------------------------------------
    // Leave a value empty/null to omit that sbatch flag entirely.
    slurm_account = null
    slurm_partition = null
    slurm_qos = null
    slurm_extra_options = ''

    // ---- Parallelism -------------------------------------------------------
    // Maximum distinct coassembly groups submitted/running at once.
    max_parallel_coassemblies = 4

    // Wall time and retry policy for each group-level MEGAHIT assembly.
    coassembly_time = '48h'
    coassembly_max_retries = 2

    // One coassembly per exclusive node by default.
    slurm_exclusive = true

    // Set false if the local SLURM installation rejects --mem=0.
    slurm_request_all_memory = true

    // Optional commands run in each SLURM job before the process script.
    // Example: --slurm_before_script 'source /etc/profile; module load python'
    slurm_before_script = ''
}

process {

    // Heavy fan-out work: one SLURM job for each coassembly group.
    withName: 'ASSEMBLE_COASSEMBLY' {
        executor = 'slurm'

        clusterOptions = {
            def opts = []

            if (params.slurm_exclusive) {
                opts << '--exclusive'
                opts << '--nodes=1'

                if (params.slurm_request_all_memory) {
                    // SLURM --mem=0 requests all memory on the allocated node.
                    opts << '--mem=0'
                }
            }

            if (params.slurm_account) {
                opts << "--account=${params.slurm_account}"
            }

            if (params.slurm_partition) {
                opts << "--partition=${params.slurm_partition}"
            }

            if (params.slurm_qos) {
                opts << "--qos=${params.slurm_qos}"
            }

            if (params.slurm_extra_options) {
                opts << "${params.slurm_extra_options}"
            }

            return opts.join(' ')
        }

        time = params.coassembly_time
        beforeScript = { params.slurm_before_script ?: null }
        maxForks = params.max_parallel_coassemblies

        // Retry scheduler/node failures, but fail immediately on real assembly
        // errors so the group log remains the authoritative diagnostic.
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247, 250, 251] ? 'retry' : 'terminate' }
        maxRetries = params.coassembly_max_retries

        // Coassembly input FASTQs can be large; use shared storage by default.
        scratch = false
    }

    // Keep lightweight orchestration steps off the cluster queue.
    withName: 'SETUP_MODULE2B_TOOLS|PREPARE_COASSEMBLY_GROUPS|WRITE_ASSEMBLY_SUMMARY|WRITE_COASSEMBLY_TRIMMED_MANIFEST' {
        executor = 'local'
        cpus = 1
    }
}

executor {
    // Global submission cap matching the per-process maxForks cap above.
    queueSize = params.max_parallel_coassemblies
    submitRateLimit = '20/1min'
    pollInterval = '30 sec'
    queueStatInterval = '2 min'
}

// params.outdir is assigned in the workflow after configuration loads, so use
// the same command-line base-directory derivation for report locations.
timeline {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: (params.output_dir ?: '.')}/module_2b_coassembly/pipeline_info/module2b_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: (params.output_dir ?: '.')}/module_2b_coassembly/pipeline_info/module2b_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: (params.output_dir ?: '.')}/module_2b_coassembly/pipeline_info/module2b_trace.txt"
    fields = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem'
}
