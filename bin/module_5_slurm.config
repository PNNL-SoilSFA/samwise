/*
 * SLURM execution profile for SAMWISE Module 5 subtractive assembly.
 *
 * Usage:
 *
 *   nextflow run module_5_subassembly.nf \
 *       -c bin/module_5_slurm.config \
 *       --working_dir /path/to/results \
 *       --slurm_account samwise \
 *       --max_parallel_subassembly 8 \
 *       --threads 36 \
 *       --megahit --metaspades \
 *       --secondpass_metabat2 true --secondpass_quickbin true --secondpass_maxbin2 true
 *
 * What this changes versus running without it:
 *
 *   Before: every task runs on the launch node with the local executor. Each
 *           read-mapping and subtractive-assembly task asks for --threads
 *           cores, so on a 36-core node exactly one runs at a time and the
 *           rest queue behind it.
 *
 *   After:  Nextflow only orchestrates the per-sample fan-out. Each
 *           MAP_READS_TO_REFINED_MAGS and ASSEMBLE_SUBTRACTIVE task is
 *           submitted as its own sbatch job on its own exclusive node, up to
 *           --max_parallel_subassembly at once, with the thread count the
 *           module already derives from --threads. Everything else --
 *           setup, reference preparation, summaries, and the second-pass
 *           binning / joint refinement steps -- stays local on the launch
 *           host exactly as before.
 *
 * NOTE: RUN_SECOND_PASS_BINNING and RUN_FINAL_JOINT_REFINEMENT read --threads
 * directly and run on the launch host, so the job that launches Nextflow still
 * needs a full node's worth of cores for Module 5, unlike Modules 2 and 2b
 * where the launcher only orchestrates.
 *
 * Memory: Module 5 sets no Nextflow memory directive, so there is nothing to
 * conflict with the --mem=0 that exclusive jobs add. --metaspades_memory_gb
 * and --bbmap_xmx are passed straight to the tools; keep them within the RAM
 * of the nodes the jobs land on.
 *
 * This file is opt-in. It is deliberately NOT named nextflow.config: a file
 * with that name in the repo root is auto-loaded by every module.
 */

params {

    // ---- Site-specific SLURM settings -------------------------------------
    // Leave a value empty/null to omit that sbatch flag entirely.
    slurm_account = null
    slurm_partition = null
    slurm_qos = null
    slurm_extra_options = ''

    // ---- Parallelism -------------------------------------------------------
    // Maximum Module 5 jobs (mapping + subtractive assembly) submitted/running
    // at once. This is the "X" in "run X samples in parallel on X nodes".
    max_parallel_subassembly = 8

    // Wall time per read-mapping job (BBMap against the refined MAG reference).
    mapping_time = '24h'

    // Wall time per subtractive-assembly job. metaSPAdes on the unmapped
    // fraction of a deep sample is the long pole here.
    subassembly_time = '48h'

    // Retries per job. Covers node failure and preemption, not genuine tool
    // errors.
    subassembly_max_retries = 2

    // Whether each job takes a whole node. BBMap holds the reference index in
    // memory and the assemblers are the most memory-hungry steps in the
    // pipeline, so whole nodes are the default, matching the --threads 36
    // behaviour exactly: same per-task speed, parallelism from several nodes.
    slurm_exclusive = true

    // Some sites reject --mem=0. Set false if sbatch complains, and the job
    // falls back to the cluster's default memory allocation.
    slurm_request_all_memory = true

    // Optional commands run in each SLURM job before the process script.
    // Example: --slurm_before_script 'source /etc/profile; module load python'
    slurm_before_script = ''
}

process {

    // Heavy per-sample fan-out work: one SLURM job per mapping or assembly.
    // Settings shared by both processes; wall times follow below. `cpus` is
    // deliberately NOT overridden: the module derives it from --threads
    // (or --megahit_threads / --mapping_threads / --assembly_threads).
    withName: 'MAP_READS_TO_REFINED_MAGS|ASSEMBLE_SUBTRACTIVE' {
        executor = 'slurm'

        // Built in a closure, not precomputed, so it is evaluated when a task
        // is actually submitted, with any --slurm_* command-line values
        // already in effect.
        clusterOptions = {
            def opts = []

            if (params.slurm_exclusive) {
                opts << '--exclusive'
                opts << '--nodes=1'

                if (params.slurm_request_all_memory) {
                    // SLURM --mem=0 requests all memory on the allocated node.
                    opts << '--mem=0'
                }
            }

            if (params.slurm_account) {
                opts << "--account=${params.slurm_account}"
            }

            if (params.slurm_partition) {
                opts << "--partition=${params.slurm_partition}"
            }

            if (params.slurm_qos) {
                opts << "--qos=${params.slurm_qos}"
            }

            if (params.slurm_extra_options) {
                opts << "${params.slurm_extra_options}"
            }

            return opts.join(' ')
        }

        // `?: null` means "no beforeScript" when none was supplied, without
        // injecting a literal "null" or empty line into the job script.
        beforeScript = { params.slurm_before_script ?: null }

        // Backstop for the global executor.queueSize below.
        maxForks = params.max_parallel_subassembly

        // Retry scheduler/node failures, but fail immediately on real tool
        // errors so the task log remains the authoritative diagnostic.
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247, 250, 251] ? 'retry' : 'terminate' }
        maxRetries = params.subassembly_max_retries

        // Reads, references and assemblies live on shared storage. Point this
        // at node-local storage (e.g. '/scratch') only if your site has fast
        // local disk with room for a full assembly.
        scratch = false
    }

    withName: 'MAP_READS_TO_REFINED_MAGS' {
        time = params.mapping_time
    }

    withName: 'ASSEMBLE_SUBTRACTIVE' {
        time = params.subassembly_time
    }

    // Lightweight bookkeeping steps stay on the launch host.
    withName: 'CLEAN_MODULE5_DURABLE_SUBTRACTIVE_OUTPUTS|SETUP_MODULE5_TOOLS|PREPARE_REFINED_MAG_REFERENCE|WRITE_SUBTRACTIVE_MAPPING_SUMMARY|WRITE_SUBTRACTIVE_ASSEMBLY_SUMMARIES|WRITE_SUBTRACTIVE_MODULE3_INPUTS|WRITE_SECOND_PASS_DISABLED_STATUS|COMBINE_ORIGINAL_AND_SUBTRACTIVE_BINNING_MANIFESTS|BUILD_FINAL_MAG_DATABASE_FROM_JOINT_REFINEMENT' {
        executor = 'local'
        cpus = 1
    }

    // Second-pass binning and joint refinement also stay local, but they use
    // --threads directly, so their cpus are left alone. They are candidates
    // for their own SLURM jobs in a later iteration.
    withName: 'RUN_SECOND_PASS_BINNING|RUN_FINAL_JOINT_REFINEMENT' {
        executor = 'local'
    }
}

executor {
    // Global cap on how many tasks are submitted/running at once, matching the
    // per-process maxForks cap above. This applies to every executor the run
    // uses (capping the local executor too, which is harmless here).
    //
    // IMPORTANT: do NOT rewrite this as `executor { $slurm { queueSize = N } }`.
    // That scoped form does not reliably apply on every Nextflow version, and
    // when it silently no-ops Nextflow falls back to its default queueSize of
    // 100 -- which submits every task at once and looks exactly like the flag
    // being ignored.
    queueSize = params.max_parallel_subassembly
    submitRateLimit = '20/1min'
    pollInterval = '30 sec'
    queueStatInterval = '2 min'
}

// params.outdir is assigned in the workflow after configuration loads, so use
// the same command-line base-directory derivation for report locations.
timeline {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_5_subassembly/pipeline_info/module5_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_5_subassembly/pipeline_info/module5_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.working_dir ?: params.samwise_dir ?: '.'}/module_5_subassembly/pipeline_info/module5_trace.txt"
    fields = 'task_id,hash,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem'
}
